# Copy to .env, then run npm run auth:setup to generate a unique local secret.
# Server only: never prefix secrets with VITE_ or commit .env.
JWT_SECRET_KEY=
JWT_TTL_SECONDS=3600

# Optional persistent database; relative SQLite paths are based on apps/backend.
# DATABASE_URL=sqlite+pysqlite:///./dev.sqlite

# Comma-separated browser origins. Empty disables cross-origin access.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Enable only when using cross-origin cookies; Bearer auth does not need this.
CORS_ALLOW_CREDENTIALS=false

# Public browser setting: use /api for the development proxy, or an absolute API URL.
VITE_API_BASE_URL=/api
# Server-only Vite development proxy target.
BACKEND_URL=http://127.0.0.1:8000
